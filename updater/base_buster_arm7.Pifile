# Base image for Trixie arm64 (Pi 3/4/5 compatible)
FROM https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-2024-10-28/2024-10-22-raspios-bookworm-arm64-lite.img.xz
PUMP 1500M

# Update OS and sources to Trixie
RUN bash -c "
# Update sources to Trixie
cat > /etc/apt/sources.list << EOF
deb http://deb.debian.org/debian/ trixie main contrib non-free non-free-firmware
#deb-src http://deb.debian.org/debian/ trixie main contrib non-free non-free-firmware
EOF

apt-get update -y
DEBIAN_FRONTEND=noninteractive apt-get -y dist-upgrade
apt-get install -y sl
apt-get autoremove -y
"

RUN bash -c "
cd /root
rm -rf /usr/local/qt5
# Qt5 prebuilts will need to be rebuilt for arm64/Trixie
# For now, skip Qt5 prebuilts installation
# wget https://github.com/opencardev/prebuilts/raw/master/qt5/Qt_5151_arm64_OpenGLES2.tar.xz.part00
# cat Qt_5151_arm64_OpenGLES2.tar.xz* > Qt5_OpenGLES2.tar.xz
# tar -xf Qt5_OpenGLES2.tar.xz -C /
echo 'Qt5 needs to be rebuilt for arm64/Trixie'
"

INCLUDE updater/update.Pifile
